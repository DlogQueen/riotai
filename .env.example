# Required for voice (STT/TTS) and vision. Also powers chat if default_model
# stays "cloud" in config.json.
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Optional - alternate chat brain via OpenRouter (one key, any model: Claude,
# Llama, Gemini, etc). To use it, set settings.default_model to "openrouter"
# in config.json. Voice/STT/vision still route through OpenAI above.
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Chat brain via Groq (fast, free-tier-friendly). config.json currently sets
# settings.default_model to "groq", so this is what chat uses right now -
# voice/STT/vision still need OPENAI_API_KEY above regardless.
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional - persistent memory in Supabase instead of local SQLite
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_KEY=your-anon-or-service-key

# Optional - Coach's Hotline (phone calls + SMS via Twilio)
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_PHONE_NUMBER=+15555550100
